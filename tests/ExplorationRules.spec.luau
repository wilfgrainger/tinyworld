local TestUtil = require("./TestUtil")
local ProfileSchema = require("../src/shared/ProfileSchema")
local ExplorationRules = require("../src/shared/ExplorationRules")

return function()
	TestUtil.equal(ExplorationRules.REWARD_COINS, 250)
	TestUtil.equal(ExplorationRules.REWARD_XP, 100)
	TestUtil.equal(ExplorationRules.COMPLETE_MASK, 7)

	local profile = ProfileSchema.new()
	TestUtil.equal(ExplorationRules.count(profile), 0)

	local unknown, unknownReason = ExplorationRules.visit(profile, "hiddenCave", "day-one")
	TestUtil.isFalse(unknown)
	TestUtil.equal(unknownReason, "unknown_landmark")
	TestUtil.equal(profile.boundaryExplorationDay, "")
	TestUtil.equal(profile.boundaryExplorationMask, 0)

	local visited, reason = ExplorationRules.visit(profile, "woodlandTrail", "day-one")
	TestUtil.isTrue(visited)
	TestUtil.equal(reason, "visited")
	TestUtil.equal(profile.boundaryExplorationDay, "day-one")
	TestUtil.equal(profile.boundaryExplorationMask, 1)
	TestUtil.equal(ExplorationRules.count(profile), 1)

	visited, reason = ExplorationRules.visit(profile, "woodlandTrail", "day-one")
	TestUtil.isFalse(visited)
	TestUtil.equal(reason, "already_visited")
	TestUtil.equal(profile.boundaryExplorationMask, 1)

	local incompleteCoins = profile.coins
	local incompleteXp = profile.xp
	local incomplete, incompleteReason = ExplorationRules.claim(profile, "day-one")
	TestUtil.isFalse(incomplete)
	TestUtil.equal(incompleteReason, "incomplete")
	TestUtil.equal(profile.coins, incompleteCoins)
	TestUtil.equal(profile.xp, incompleteXp)
	TestUtil.equal(profile.boundaryExplorationClaimedDay, "")

	visited, reason = ExplorationRules.visit(profile, "cliffLookout", "day-one")
	TestUtil.isTrue(visited)
	TestUtil.equal(reason, "visited")
	visited, reason = ExplorationRules.visit(profile, "seaDock", "day-one")
	TestUtil.isTrue(visited)
	TestUtil.equal(reason, "visited")
	TestUtil.equal(profile.boundaryExplorationMask, ExplorationRules.COMPLETE_MASK)
	TestUtil.equal(ExplorationRules.count(profile), 3)

	local claimed, claimReason = ExplorationRules.claim(profile, "day-one")
	TestUtil.isTrue(claimed)
	TestUtil.equal(claimReason, "claimed")
	TestUtil.equal(profile.coins, 350)
	TestUtil.equal(profile.level, 2)
	TestUtil.equal(profile.xp, 0)
	TestUtil.equal(profile.boundaryExplorationClaimedDay, "day-one")
	TestUtil.equal(profile.boundaryExplorationMask, 0)
	TestUtil.equal(profile.boundaryCompletions, 1)

	local claimedAgain, claimedAgainReason = ExplorationRules.claim(profile, "day-one")
	TestUtil.isFalse(claimedAgain)
	TestUtil.equal(claimedAgainReason, "already_claimed")
	TestUtil.equal(profile.coins, 350)
	TestUtil.equal(profile.boundaryCompletions, 1)

	visited, reason = ExplorationRules.visit(profile, "seaDock", "day-two")
	TestUtil.isTrue(visited)
	TestUtil.equal(reason, "visited")
	TestUtil.equal(profile.boundaryExplorationDay, "day-two")
	TestUtil.equal(profile.boundaryExplorationMask, 4)
	TestUtil.equal(ExplorationRules.count(profile), 1)
	local nextDayClaim, nextDayClaimReason = ExplorationRules.claim(profile, "day-two")
	TestUtil.isFalse(nextDayClaim)
	TestUtil.equal(nextDayClaimReason, "incomplete")
end
