local TestUtil = require("./TestUtil")
local ProfileSchema = require("../src/shared/ProfileSchema")
local Profession = require("../src/shared/Profession")

return function()
	local profile = ProfileSchema.new()
	TestUtil.equal(Profession.xpForNextCourierLevel(1), 200)
	TestUtil.equal(Profession.addCourierXp(profile, 100), 0)
	TestUtil.equal(profile.courierLevel, 1)
	TestUtil.equal(profile.courierXp, 100)

	TestUtil.equal(Profession.addCourierXp(profile, 350), 1)
	TestUtil.equal(profile.courierLevel, 2)
	TestUtil.equal(profile.courierXp, 250)
	TestUtil.equal(Profession.addCourierXp(profile, -10), 0)

	TestUtil.equal(Profession.xpForNextLevel(1), 200)
	TestUtil.equal(Profession.xpForNextLevel(3), 400)
	TestUtil.equal(Profession.addXp(profile, "Farmer", 50), 0)
	TestUtil.equal(profile.farmerLevel, 1)
	TestUtil.equal(profile.farmerXp, 50)
	TestUtil.equal(Profession.addXp(profile, "Farmer", 350), 1)
	TestUtil.equal(profile.farmerLevel, 2)
	TestUtil.equal(profile.farmerXp, 200)
	TestUtil.equal(Profession.addXp(profile, "Designer", 450), 1)
	TestUtil.equal(profile.designerLevel, 2)
	TestUtil.equal(profile.designerXp, 250)
	TestUtil.equal(Profession.addXp(profile, "NotAJob", 100), 0)
	TestUtil.equal(Profession.addXp(profile, "Designer", -10), 0)
end

