local TestUtil = require("./TestUtil")
local ProfileSchema = require("../src/shared/ProfileSchema")
local PortalRules = require("../src/shared/PortalRules")

return function()
	local profile = ProfileSchema.new()
	PortalRules.completeGiantKitchen(profile)
	TestUtil.equal(profile.coins, 400)
	TestUtil.equal(profile.level, 2)
	TestUtil.equal(profile.xp, 100)
	TestUtil.equal(profile.inventory.SugarCrystal, 1)
	TestUtil.equal(profile.portalCompletions, 1)

	local meadow = PortalRules.getWorld("MoonlitMeadow")
	TestUtil.isTrue(meadow ~= nil)
	TestUtil.equal(meadow.displayName, "Moonlit Meadow")
	TestUtil.equal(meadow.collectibleName, "Moonlit Seed")

	local cloudpost = PortalRules.getWorld("CloudpostObservatory")
	TestUtil.isTrue(cloudpost ~= nil)
	TestUtil.equal(cloudpost.inventoryItem, "BottledBreeze")
	local clockwork = PortalRules.getWorld("ClockworkOrchard")
	TestUtil.isTrue(clockwork ~= nil)
	TestUtil.equal(clockwork.inventoryItem, "ClockworkLeaf")

	local secondProfile = ProfileSchema.new()
	TestUtil.isTrue(PortalRules.completeWorld(secondProfile, "MoonlitMeadow"))
	TestUtil.equal(secondProfile.coins, 450)
	TestUtil.equal(secondProfile.level, 2)
	TestUtil.equal(secondProfile.xp, 125)
	TestUtil.equal(secondProfile.inventory.MeadowSeed, 1)
	TestUtil.isFalse(PortalRules.completeWorld(secondProfile, "UnknownWorld"))

	local cloudProfile = ProfileSchema.new()
	TestUtil.isTrue(PortalRules.completeWorld(cloudProfile, "CloudpostObservatory"))
	TestUtil.equal(cloudProfile.inventoryStacks.BottledBreeze, 1)
	local clockProfile = ProfileSchema.new()
	TestUtil.isTrue(PortalRules.completeWorld(clockProfile, "ClockworkOrchard"))
	TestUtil.equal(clockProfile.inventoryStacks.ClockworkLeaf, 1)

	local fullPortalProfile = ProfileSchema.new()
	fullPortalProfile.inventoryStacks.BottledBreeze = 99
	local blocked = PortalRules.completeWorld(fullPortalProfile, "CloudpostObservatory")
	TestUtil.isFalse(blocked)
	TestUtil.equal(fullPortalProfile.coins, 100)
	TestUtil.equal(fullPortalProfile.xp, 0)
	TestUtil.equal(fullPortalProfile.portalCompletions, 0)
	TestUtil.equal(fullPortalProfile.inventoryStacks.BottledBreeze, 99)
	TestUtil.isFalse(fullPortalProfile.discoveredWorlds.CloudpostObservatory == true)
end
